# AgentBot 配置模板
#
# 用法：复制为 .env 并填入真实值
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，密钥不会进仓库。

# ── 必填 ───────────────────────────────────────────────
# 模型 API Key
# 兼容 OpenAI 接口的服务都可以（DeepSeek / OpenAI / 自建网关）
AGENT_API_KEY=

# ── 可选 ───────────────────────────────────────────────
# 接口地址，默认 DeepSeek
# AGENT_BASE_URL=https://api.deepseek.com/v1

# 默认模型
# AGENT_MODEL=deepseek-chat

# 在群里显示的主人名（不配则显示「主人」）
# AGENT_OWNER_NAME=

# 数据目录，默认 <项目根>/.agentbot
# AGENT_DATA_DIR=

# 设为 off 可关闭回合后的自动记忆抽取（保留模型主动调用 update_state 写记忆）
# AGENT_MEMORY_EXTRACTION=off

# ── 写代码类长任务的额度（一般不用改）──────────────────
# 每个回合的上下文预算，默认 1M（支持 200K / 1M 写法）；模型实际上限更小时会自动识别并收缩
# AGENT_MAX_CONTEXT_TOKENS=1M

# 每个回合最多几轮模型往返 / 几次工具调用 / 工具输入输出各多少字符
# AGENT_MAX_ITERATIONS=64
# AGENT_MAX_TOOL_CALLS=256
# AGENT_MAX_TOOL_CHARS=1000000
