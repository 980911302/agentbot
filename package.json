{
  "name": "agentbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "tsx src/index.ts",
    "server": "tsx src/server/main.ts",
    "build": "node scripts/clean.mjs dist && tsc",
    "build:all": "npm run build && npm run web:build",
    "clean": "node scripts/clean.mjs dist web/dist test-results",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "check": "npm run typecheck && npm test && npm run build:all",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "desktop": "npm run build && npm run web:build && npm --prefix desktop start",
    "test": "node --test --import tsx \"./test/*.test.ts\"",
    "test:watch": "node --test --watch --import tsx \"./test/*.test.ts\"",
    "e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
